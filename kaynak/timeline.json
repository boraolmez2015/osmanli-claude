    }
   ],
   "narr": {
    "tr": [
     {
      "key": "c09_0",
      "start": 533.4,
      "dur": 8.4,
      "text": "Yirmi dokuz Mayıs, şafaktan önce. Davullar, borazanlar ve binlerce ses aynı anda yükseldi."
     },
     {
      "key": "c09_1",
      "start": 544.0,
      "dur": 7.05,
      "text": "Hücum dalgalar halinde geldi. Önce ilk birlikler, sonra Anadolu askerleri surlara yüklendi."
     },
     {
      "key": "c09_2",
      "start": 553.25,
      "dur": 6.7,
      "text": "Savunucular direndi. Ama sonra Giustiniani ağır yaralandı ve geri çekildi. Savunma sarsıldı."
     },
     {
      "key": "c09_x0",
      "start": 562.15,
      "dur": 4.35,
      "text": "Saatler boyunca surlarda ölüm kalım mücadelesi sürdü."
     },
     {
      "key": "c09_3",
      "start": 568.7,
      "dur": 4.75,
      "text": "Tam o anda Sultan son kozunu oynadı: Yeniçeriler."
     },
     {
      "key": "c09_4",
      "start": 575.65,
      "dur": 5.65,
      "text": "Disiplinli, sessiz ve kararlı bir şekilde gediklere doğru ilerlediler."
     }
    ],
    "en": [
     {
      "key": "c09_0",
      "start": 533.4,
      "dur": 6.45,
      "text": "May twenty-ninth, before dawn. Drums, trumpets and thousands of voices rose at once."
     },
     {
      "key": "c09_1",
      "start": 542.05,
      "dur": 8.35,
      "text": "The assault came in waves. First the irregular troops, then the Anatolian soldiers threw themselves at the walls."
     },
     {
      "key": "c09_2",
      "start": 552.6,
      "dur": 8.4,
      "text": "The defenders held. But then Giustiniani was badly wounded and withdrew. The defense began to waver."
     },
     {
      "key": "c09_x0",
      "start": 563.2,
      "dur": 4.85,
      "text": "For hours, a struggle of life and death raged on the walls."
     },
     {
      "key": "c09_3",
      "start": 570.25,
      "dur": 5.75,
      "text": "At that very moment, the Sultan played his final card: the Janissaries."
     },
     {
      "key": "c09_4",
      "start": 578.2,
      "dur": 5.35,
      "text": "Disciplined, silent and determined, they advanced toward the breaches."
     }
    ]
   },
   "battle": true,
