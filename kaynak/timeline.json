   "narr": {
    "tr": [
     {
      "key": "c00_0",
      "start": 3.0,
      "dur": 5.2,
      "text": "Yıl bin dört yüz elli üç. Bahar sabahı, Boğaz'ın üzerinde sis var."
     },
     {
      "key": "c00_1",
      "start": 10.4,
      "dur": 6.9,
      "text": "Sisin ardında, bin yılı aşkın süredir ayakta duran bir şehir uyanıyor: Konstantinopolis."
     },
     {
      "key": "c00_2",
      "start": 19.5,
      "dur": 7.35,
      "text": "Elli üç gün sonra bu şehir artık eskisi gibi olmayacak. Ve dünya tarihi yeni bir sayfa açacak."
     },
     {
      "key": "c00_x0",
      "start": 29.05,
      "dur": 5.9,
      "text": "Bu, dünyanın en güçlü surlarına karşı, genç bir sultanın hikâyesi."
     }
    ],
    "en": [
     {
      "key": "c00_0",
      "start": 3.0,
      "dur": 7.0,
      "text": "The year is fourteen fifty-three. A spring morning, and mist lies over the Bosphorus."
     },
     {
      "key": "c00_1",
      "start": 12.2,
      "dur": 7.8,
      "text": "Behind the mist, a city that has stood for more than a thousand years is waking: Constantinople."
     },
     {
      "key": "c00_2",
      "start": 22.2,
      "dur": 7.5,
      "text": "In fifty-three days, this city will never be the same. And world history will turn a new page."
     },
     {
      "key": "c00_x0",
      "start": 31.9,
      "dur": 6.75,
      "text": "This is the story of a young sultan against the strongest walls in the world."
     }
    ]
   },
   "battle": false,
   "embers": false,
   "booms": []
  },
