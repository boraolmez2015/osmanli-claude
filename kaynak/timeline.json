   ],
   "narr": {
    "tr": [
     {
      "key": "c10_0",
      "start": 609.4,
      "dur": 6.45,
      "text": "Bu kargaşanın ortasında, dev cüsseli bir yeniçeri surlara tırmandı: Ulubatlı Hasan."
     },
     {
      "key": "c10_1",
      "start": 618.05,
      "dur": 4.7,
      "text": "Oklar ve taşlar altında, sancağı burçlardan birine dikti."
     },
     {
      "key": "c10_2",
      "start": 624.95,
      "dur": 8.75,
      "text": "Anlatılara göre Hasan oracıkta şehit düştü. Ama sancak dalgalanıyordu, ve onu gören binlerce asker içeri aktı."
     },
     {
      "key": "c10_x0",
      "start": 635.9,
      "dur": 6.0,
      "text": "Kısa süre içinde surların üzerinde birçok sancak belirdi. Savunma çöküyordu."
     }
    ],
    "en": [
     {
      "key": "c10_0",
      "start": 609.4,
      "dur": 7.75,
      "text": "In the middle of the chaos, a giant Janissary climbed the walls: Hasan of Ulubat."
     },
     {
      "key": "c10_1",
      "start": 619.35,
      "dur": 5.3,
      "text": "Under arrows and stones, he planted the banner on one of the towers."
     },
     {
      "key": "c10_2",
      "start": 626.85,
      "dur": 10.65,
      "text": "According to the stories, Hasan fell there as a martyr. But the banner was flying, and thousands of soldiers who saw it poured inside."
     },
     {
      "key": "c10_x0",
      "start": 639.7,
      "dur": 5.6,
      "text": "Within moments, more banners appeared along the walls. The defense was collapsing."
     }
    ]
   },
