   ],
   "narr": {
    "tr": [
     {
      "key": "c02_0",
      "start": 111.4,
      "dur": 5.6,
      "text": "Edirne'de, genç bir sultan bu şehrin hayalini kuruyordu: İkinci Mehmed."
     },
     {
      "key": "c02_1",
      "start": 119.2,
      "dur": 5.05,
      "text": "Bin dört yüz elli birde tahta çıktığında henüz on dokuz yaşındaydı."
     },
     {
      "key": "c02_x0",
      "start": 126.45,
      "dur": 6.5,
      "text": "Babası İkinci Murad'dan büyük bir devlet devralmıştı. Ama onun gözü daha büyüğündeydi."
     },
     {
      "key": "c02_2",
      "start": 135.15,
      "dur": 6.1,
      "text": "Birçok dil biliyor, haritalar inceliyor, mühendislik ve savaş sanatı üzerine çalışıyordu."
     },
     {
      "key": "c02_3",
      "start": 143.45,
      "dur": 7.75,
      "text": "Geceler boyunca surların planlarını çizdiği anlatılır. Tek bir hedefi vardı: Konstantinopolis'i almak."
     },
     {
      "key": "c02_x1",
      "start": 153.4,
      "dur": 6.5,
      "text": "Avrupa'nın sarayları bu genç hükümdarı ciddiye almadı. Çok yakında pişman olacaklardı."
     }
    ],
    "en": [
     {
      "key": "c02_0",
      "start": 111.4,
      "dur": 5.3,
      "text": "In Edirne, a young sultan dreamed of this city: Mehmed the Second."
     },
     {
      "key": "c02_1",
      "start": 118.9,
      "dur": 6.1,
      "text": "When he took the throne in fourteen fifty-one, he was only nineteen years old."
     },
     {
      "key": "c02_x0",
      "start": 127.2,
      "dur": 7.2,
      "text": "He had inherited a great state from his father, Murad the Second. But his eyes were set on something greater."
     },
     {
      "key": "c02_2",
      "start": 136.6,
      "dur": 6.5,
      "text": "He spoke several languages, studied maps, and devoted himself to engineering and the art of war."
     },
     {
      "key": "c02_3",
      "start": 145.3,
      "dur": 9.4,
      "text": "It is said he spent nights drawing plans of the walls. He had a single goal: to take Constantinople."
     },
     {
      "key": "c02_x1",
      "start": 156.9,
      "dur": 7.1,
      "text": "The courts of Europe did not take this young ruler seriously. Very soon, they would regret it."
     }
    ]
   },
   "battle": false,
   "embers": false,
   "booms": []
  },
