   ],
   "narr": {
    "tr": [
     {
      "key": "c01_0",
      "start": 51.0,
      "dur": 6.9,
      "text": "Konstantinopolis, Roma İmparatoru Konstantin tarafından üç yüz otuz yılında başkent yapıldı."
     },
     {
      "key": "c01_1",
      "start": 58.7,
      "dur": 5.85,
      "text": "Yüzyıllar boyunca dünyanın en zengin, en kalabalık şehirlerinden biri oldu."
     },
     {
      "key": "c01_x0",
      "start": 65.35,
      "dur": 6.9,
      "text": "Doğu ile Batı'nın, Asya ile Avrupa'nın buluştuğu bu noktada, ticaret yolları kesişiyordu."
     },
     {
      "key": "c01_2",
      "start": 73.05,
      "dur": 7.85,
      "text": "Ama bin dört yüz elli üçe gelindiğinde, koca imparatorluktan geriye neredeyse yalnızca şehrin kendisi kalmıştı."
     },
     {
      "key": "c01_3",
      "start": 81.7,
      "dur": 8.6,
      "text": "Onu koruyan şey ise efsanevi kara surlarıydı. Üç katlı savunma hattı, binlerce yıl düşmanlarını geri püskürtmüştü."
     },
     {
      "key": "c01_4",
      "start": 91.1,
      "dur": 6.75,
      "text": "Haliç'in ağzına ise devasa bir zincir gerilmişti. Hiçbir gemi içeri giremeyecekti."
     },
     {
      "key": "c01_x1",
      "start": 98.65,
      "dur": 7.25,
      "text": "Şehir, bin yıl boyunca defalarca kuşatıldı. Ama surlar hiçbir zaman zorla aşılamamıştı."
     }
    ],
    "en": [
     {
      "key": "c01_0",
      "start": 51.0,
      "dur": 6.5,
      "text": "Constantinople was made a capital by the Roman Emperor Constantine in the year three hundred and thirty."
     },
     {
      "key": "c01_1",
      "start": 58.217,
      "dur": 5.65,
      "text": "For centuries it was one of the richest and most populous cities in the world."
     },
     {
      "key": "c01_x0",
      "start": 64.583,
      "dur": 6.65,
      "text": "Here, where East met West and Asia met Europe, the great trade routes crossed."
     },
     {
      "key": "c01_2",
      "start": 71.95,
      "dur": 6.95,
      "text": "But by fourteen fifty-three, almost nothing remained of the great empire except the city itself."
     },
     {
      "key": "c01_3",
      "start": 79.617,
      "dur": 8.6,
      "text": "What protected it were the legendary land walls. A triple line of defense that had turned back enemies for a thousand years."
     },
     {
      "key": "c01_4",
      "start": 88.933,
      "dur": 8.45,
      "text": "And across the mouth of the Golden Horn, a massive chain was stretched. No ship would get inside."
     },
     {
      "key": "c01_x1",
      "start": 98.1,
      "dur": 7.8,
      "text": "The city had been besieged again and again for a thousand years. But the walls had never been taken by storm."
     }
    ]
   },
   "battle": false,
   "embers": false,
