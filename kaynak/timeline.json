    },
    {
     "id": "c03d_1",
     "img": "c03d",
     "part": 1,
     "motion": "orbit_r",
     "start": 217.4,
     "dur": 7.0,
     "render_dur": 7.75
    }
   ],
   "narr": {
    "tr": [
     {
      "key": "c03_0",
      "start": 171.4,
      "dur": 3.5,
      "text": "İlk hamle bin dört yüz elli iki baharında geldi."
     },
     {
      "key": "c03_1",
      "start": 177.07,
      "dur": 9.0,
      "text": "Boğaz'ın en dar noktasında, Anadolu Hisarı'nın tam karşısında, devasa bir kale yükselmeye başladı: Rumeli Hisarı."
     },
     {
      "key": "c03_2",
      "start": 188.24,
      "dur": 5.75,
      "text": "Binlerce işçi gece gündüz çalıştı. Kale yaklaşık dört buçuk ayda tamamlandı."
     },
     {
      "key": "c03_3",
      "start": 196.16,
      "dur": 7.05,
      "text": "Artık Karadeniz'den şehre yardım gelmesi çok zordu. Halk ona bir isim verdi: Boğazkesen."
     },
     {
      "key": "c03_x0",
      "start": 205.38,
      "dur": 7.25,
      "text": "Boğaz'dan geçen gemiler artık durmak ve izin almak zorundaydı. Bu bir meydan okumaydı."
     },
     {
      "key": "c03_x1",
      "start": 214.8,
      "dur": 7.1,
      "text": "Konstantinopolis'te imparator, Batı'ya mektuplar yazarak yardım istedi. Ama gelen yardım çok azdı."
     }
    ],
    "en": [
     {
      "key": "c03_0",
      "start": 171.4,
      "dur": 4.65,
      "text": "The first move came in the spring of fourteen fifty-two."
     },
     {
      "key": "c03_1",
      "start": 177.21,
      "dur": 10.15,
      "text": "At the narrowest point of the Bosphorus, directly across from the Anatolian Fortress, a huge castle began to rise: Rumeli Hisarı."
     },
     {
      "key": "c03_2",
      "start": 188.52,
      "dur": 8.7,
      "text": "Thousands of workers labored day and night. The fortress was finished in about four and a half months."
     },
     {
      "key": "c03_3",
      "start": 198.38,
      "dur": 7.55,
      "text": "Now help from the Black Sea could hardly reach the city. People gave it a name: the Throat Cutter."
     },
     {
      "key": "c03_x0",
      "start": 207.09,
      "dur": 7.15,
      "text": "Ships passing through the Bosphorus now had to stop and ask permission. It was a challenge."
     },
     {
      "key": "c03_x1",
      "start": 215.4,
      "dur": 6.5,
      "text": "In Constantinople, the emperor wrote letters to the West, begging for help. But very little came."
     }
    ]
   },
   "battle": false,
   "embers": true,
   "booms": []
  },
