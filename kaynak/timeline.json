    }
   ],
   "narr": {
    "tr": [
     {
      "key": "c05_0",
      "start": 287.4,
      "dur": 5.15,
      "text": "Altı Nisan bin dört yüz elli üç. Osmanlı ordusu surların önünde."
     },
     {
      "key": "c05_1",
      "start": 294.75,
      "dur": 5.05,
      "text": "Tahminlere göre seksen binden fazla asker, ufka kadar uzanan çadırlar."
     },
     {
      "key": "c05_2",
      "start": 302.0,
      "dur": 4.05,
      "text": "Karşılarında ise yalnızca yedi bin kadar savunucu vardı."
     },
     {
      "key": "c05_x0",
      "start": 308.25,
      "dur": 6.1,
      "text": "Şehrin kara surları boyunca topçular, okçular ve piyadeler mevzilerini aldı."
     },
     {
      "key": "c05_3",
      "start": 316.55,
      "dur": 8.65,
      "text": "Onları son Bizans İmparatoru, On Birinci Konstantin yönetiyordu. Yanında Cenevizli komutan Giustiniani vardı."
     },
     {
      "key": "c05_4",
      "start": 327.4,
      "dur": 2.8,
      "text": "Ve toplar konuşmaya başladı."
     }
    ],
    "en": [
     {
      "key": "c05_0",
      "start": 287.4,
      "dur": 6.0,
      "text": "April sixth, fourteen fifty-three. The Ottoman army stands before the walls."
     },
     {
      "key": "c05_1",
      "start": 295.6,
      "dur": 6.55,
      "text": "By most estimates more than eighty thousand soldiers, and tents stretching to the horizon."
     },
     {
      "key": "c05_2",
      "start": 304.35,
      "dur": 4.65,
      "text": "Facing them were only about seven thousand defenders."
     },
     {
      "key": "c05_x0",
      "start": 311.2,
      "dur": 6.1,
      "text": "Along the land walls, gunners, archers and infantry took up their positions."
     },
     {
      "key": "c05_3",
      "start": 319.5,
      "dur": 8.6,
      "text": "They were led by the last Byzantine Emperor, Constantine the Eleventh. At his side stood the Genoese commander Giustiniani."
     },
     {
      "key": "c05_4",
      "start": 330.3,
      "dur": 2.95,
      "text": "And the cannons began to speak."
     }
    ]
   },
   "battle": true,
