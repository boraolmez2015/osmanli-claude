   "narr": {
    "tr": [
     {
      "key": "c12_0",
      "start": 729.4,
      "dur": 6.25,
      "text": "İstanbul, Osmanlı İmparatorluğu'nun yeni başkenti oldu ve yüzyıllar boyunca öyle kaldı."
     },
     {
      "key": "c12_1",
      "start": 737.85,
      "dur": 5.95,
      "text": "Pek çok tarihçiye göre bu fetih Orta Çağ'ı kapattı, Yeni Çağ'ı başlattı."
     },
     {
      "key": "c12_x0",
      "start": 746.0,
      "dur": 6.4,
      "text": "Fatih Sultan Mehmed şehri yeniden imar etti, farklı halklara kapılarını açtı."
     },
     {
      "key": "c12_2",
      "start": 754.6,
      "dur": 6.2,
      "text": "İki kıtanın buluştuğu bu şehir, bugün hâlâ dünyanın kalbinde atıyor."
     },
     {
      "key": "c12_3",
      "start": 763.0,
      "dur": 6.25,
      "text": "Bin dört yüz elli üç. Bir şehrin, bir imparatorluğun ve bir çağın hikâyesi."
     }
    ],
    "en": [
     {
      "key": "c12_0",
      "start": 729.4,
      "dur": 6.55,
      "text": "Istanbul became the new capital of the Ottoman Empire, and remained so for centuries."
     },
     {
      "key": "c12_1",
      "start": 738.15,
      "dur": 6.35,
      "text": "For many historians, this conquest closed the Middle Ages and opened the modern era."
     },
     {
      "key": "c12_x0",
      "start": 746.7,
      "dur": 6.75,
      "text": "Mehmed the Conqueror rebuilt the city and opened its doors to many peoples."
     },
     {
      "key": "c12_2",
      "start": 755.65,
      "dur": 5.4,
      "text": "Where two continents meet, this city still beats at the heart of the world."
     },
     {
      "key": "c12_3",
      "start": 763.25,
      "dur": 6.1,
      "text": "Fourteen fifty-three. The story of a city, an empire, and an age."
     }
    ]
   },
