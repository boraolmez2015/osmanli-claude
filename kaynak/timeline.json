    },
    {
     "id": "c07d_1",
     "img": "c07d",
     "part": 1,
     "motion": "dolly_in",
     "start": 466.15,
     "dur": 8.25,
     "render_dur": 9.0
    }
   ],
   "narr": {
    "tr": [
     {
      "key": "c07_0",
      "start": 411.4,
      "dur": 5.65,
      "text": "Yirmi iki Nisan sabahı, Haliç'teki savunucular gözlerine inanamadı."
     },
     {
      "key": "c07_1",
      "start": 419.25,
      "dur": 4.15,
      "text": "Osmanlı gemileri tepelerin üzerinden kayarak geliyordu."
     },
     {
      "key": "c07_x0",
      "start": 425.6,
      "dur": 4.3,
      "text": "Bu, tarihin en cesur askeri manevralarından biriydi."
     },
     {
      "key": "c07_2",
      "start": 432.1,
      "dur": 9.75,
      "text": "Gece boyunca yağlanmış kızaklar üzerinde, öküzler ve askerler tarafından çekilen gemiler, Galata'nın arkasından karadan Haliç'e indirilmişti."
     },
     {
      "key": "c07_3",
      "start": 444.05,
      "dur": 4.8,
      "text": "Zincir aşılmıştı. Şehir artık iki yandan kuşatılmıştı."
     },
     {
      "key": "c07_x1",
      "start": 451.05,
      "dur": 8.4,
      "text": "Savunucular artık Haliç tarafındaki deniz surlarını da korumak zorundaydı. Zaten az olan askerler daha da dağıldı."
     }
    ],
    "en": [
     {
      "key": "c07_0",
      "start": 411.4,
      "dur": 7.85,
      "text": "On the morning of April twenty-second, the defenders in the Golden Horn could not believe their eyes."
     },
     {
      "key": "c07_1",
      "start": 421.45,
      "dur": 3.85,
      "text": "Ottoman ships were sliding down over the hills."
     },
     {
      "key": "c07_x0",
      "start": 427.5,
      "dur": 5.25,
      "text": "It was one of the boldest military maneuvers in history."
     },
     {
      "key": "c07_2",
      "start": 434.95,
      "dur": 12.05,
      "text": "Through the night, on greased wooden rollers, pulled by oxen and soldiers, the ships had been carried over land behind Galata into the Golden Horn."
     },
     {
      "key": "c07_3",
      "start": 449.2,
      "dur": 5.45,
      "text": "The chain had been bypassed. Now the city was besieged from two sides."
     },
     {
      "key": "c07_x1",
      "start": 456.85,
      "dur": 8.15,
      "text": "The defenders now had to guard the sea walls along the Golden Horn too. Their already few soldiers were stretched even thinner."
     }
    ]
   },
   "battle": false,
   "embers": false,
   "booms": []
  },
