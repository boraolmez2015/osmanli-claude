    },
    {
     "id": "c04d_1",
     "img": "c04d",
     "part": 1,
     "motion": "dolly_in",
     "start": 276.9,
     "dur": 7.5,
     "render_dur": 8.25
    }
   ],
   "narr": {
    "tr": [
     {
      "key": "c04_0",
      "start": 227.4,
      "dur": 4.3,
      "text": "Sultan'ın en büyük silahı ise henüz görülmemiş bir şeydi."
     },
     {
      "key": "c04_1",
      "start": 233.9,
      "dur": 5.35,
      "text": "Urban adında bir top dökümcüsü, Edirne'de devasa toplar döktü."
     },
     {
      "key": "c04_x0",
      "start": 241.45,
      "dur": 6.85,
      "text": "Urban önce hizmetlerini Bizans'a sunmuştu. Ama imparator ona istediği ücreti ödeyemedi."
     },
     {
      "key": "c04_2",
      "start": 250.5,
      "dur": 8.9,
      "text": "En büyüğü yüzlerce kiloluk taş gülleler fırlatabiliyordu. Onu taşımak için düzinelerce öküz ve yüzlerce adam gerekti."
     },
     {
      "key": "c04_3",
      "start": 261.6,
      "dur": 7.45,
      "text": "Günde yalnızca birkaç kez ateşlenebiliyordu. Ama her atışta yer sarsılıyor, surlar titriyordu."
     },
     {
      "key": "c04_x1",
      "start": 271.25,
      "dur": 4.75,
      "text": "Bu toplar, savaşın kurallarını sonsuza dek değiştirecekti."
     }
    ],
    "en": [
     {
      "key": "c04_0",
      "start": 227.4,
      "dur": 4.75,
      "text": "But the Sultan's greatest weapon was something never seen before."
     },
     {
      "key": "c04_1",
      "start": 234.35,
      "dur": 5.3,
      "text": "A cannon founder named Urban cast enormous guns in Edirne."
     },
     {
      "key": "c04_x0",
      "start": 241.85,
      "dur": 6.5,
      "text": "Urban had first offered his services to Byzantium. But the emperor could not pay what he asked."
     },
     {
      "key": "c04_2",
      "start": 250.55,
      "dur": 8.9,
      "text": "The largest could hurl stone balls weighing hundreds of kilograms. Dozens of oxen and hundreds of men were needed to move it."
     },
     {
      "key": "c04_3",
      "start": 261.65,
      "dur": 8.95,
      "text": "It could fire only a few times a day. But with every shot the ground shook and the walls trembled."
     },
     {
      "key": "c04_x1",
      "start": 272.8,
      "dur": 4.0,
      "text": "These guns would change the rules of war forever."
     }
    ]
   },
   "battle": true,
   "embers": true,
   "booms": [
    278.4
   ]
  },
