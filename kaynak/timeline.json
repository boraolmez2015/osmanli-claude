   ],
   "narr": {
    "tr": [
     {
      "key": "c11_0",
      "start": 665.4,
      "dur": 8.2,
      "text": "Son Bizans İmparatoru, askerlerinin arasında savaşarak hayatını kaybetti. Bin yıllık imparatorluk sona ermişti."
     },
     {
      "key": "c11_x0",
      "start": 675.8,
      "dur": 5.0,
      "text": "Şehrin sokaklarında son direniş noktaları da birer birer düştü."
     },
     {
      "key": "c11_1",
      "start": 683.0,
      "dur": 6.1,
      "text": "Öğleden sonra yirmi bir yaşındaki Sultan, beyaz atının üzerinde şehre girdi."
     },
     {
      "key": "c11_2",
      "start": 691.3,
      "dur": 7.0,
      "text": "Doğruca Ayasofya'ya gitti. Devasa kubbenin altında durdu ve sessizce etrafına baktı."
     },
     {
      "key": "c11_3",
      "start": 700.5,
      "dur": 5.65,
      "text": "O günden sonra ona bir isim verildi: Fatih. Yani, Fetheden."
     }
    ],
    "en": [
     {
      "key": "c11_0",
      "start": 665.4,
      "dur": 8.6,
      "text": "The last Byzantine Emperor died fighting among his soldiers. A thousand-year empire had come to an end."
     },
     {
      "key": "c11_x0",
      "start": 676.2,
      "dur": 5.25,
      "text": "In the streets of the city, the last points of resistance fell one by one."
     },
     {
      "key": "c11_1",
      "start": 683.65,
      "dur": 6.45,
      "text": "In the afternoon the twenty-one-year-old Sultan rode into the city on his white horse."
     },
     {
      "key": "c11_2",
      "start": 692.3,
      "dur": 8.25,
      "text": "He went straight to Hagia Sophia. He stood beneath the vast dome and looked around in silence."
     },
     {
      "key": "c11_3",
      "start": 702.75,
      "dur": 5.75,
      "text": "From that day on, he was given a name: Fatih. The Conqueror."
     }
    ]
   },
