     "dur": 7.0,
     "render_dur": 7.75
    }
   ],
   "narr": {
    "tr": [
     {
      "key": "c08_0",
      "start": 477.4,
      "dur": 6.6,
      "text": "Kuşatma toprağın altında da sürüyordu. Osmanlı lağımcıları surların altına tüneller kazdı."
     },
     {
      "key": "c08_1",
      "start": 486.2,
      "dur": 5.85,
      "text": "Savunucular karşı tüneller açtı. Karanlıkta, meşale ışığında çarpışmalar yaşandı."
     },
     {
      "key": "c08_x0",
      "start": 494.25,
      "dur": 5.1,
      "text": "Bazı tüneller bulunup su ile basıldı, bazıları ateşe verildi."
     },
     {
      "key": "c08_2",
      "start": 501.55,
      "dur": 7.1,
      "text": "Mayıs'ın sonlarına doğru gökyüzünde bir ay tutulması görüldü. Şehirde pek çok kişi bunu kötüye yordu."
     },
     {
      "key": "c08_x1",
      "start": 510.85,
      "dur": 6.4,
      "text": "Kuşatma yedinci haftasına girmişti. Her iki taraf da sonun yaklaştığını hissediyordu."
     },
     {
      "key": "c08_x2",
      "start": 519.45,
      "dur": 3.4,
      "text": "Sultan, son bir büyük hücum için emir verdi."
     }
    ],
    "en": [
     {
      "key": "c08_0",
      "start": 477.4,
      "dur": 5.9,
      "text": "The siege went on underground as well. Ottoman sappers dug tunnels beneath the walls."
     },
     {
      "key": "c08_1",
      "start": 485.5,
      "dur": 6.0,
      "text": "The defenders dug counter-tunnels. Battles were fought in the dark, by torchlight."
     },
     {
      "key": "c08_x0",
      "start": 493.7,
      "dur": 4.55,
      "text": "Some tunnels were found and flooded, others were set on fire."
     },
     {
      "key": "c08_2",
      "start": 500.45,
      "dur": 6.85,
      "text": "Late in May, a lunar eclipse was seen in the sky. Many in the city took it as an evil omen."
     },
     {
      "key": "c08_x1",
      "start": 509.5,
      "dur": 6.3,
      "text": "The siege had entered its seventh week. Both sides could feel the end approaching."
     },
     {
      "key": "c08_x2",
      "start": 518.0,
      "dur": 4.95,
      "text": "The Sultan gave the order for one last great assault."
     }
    ]
   },
   "battle": false,
   "embers": false,
   "booms": []
  },
