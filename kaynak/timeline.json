    {
     "id": "c06d_1",
     "img": "c06d",
     "part": 1,
     "motion": "orbit_r",
     "start": 400.9,
     "dur": 7.5,
     "render_dur": 8.25
    }
   ],
   "narr": {
    "tr": [
     {
      "key": "c06_0",
      "start": 351.4,
      "dur": 6.05,
      "text": "Haftalar boyunca bombardıman hiç durmadı. Surlarda büyük gedikler açıldı."
     },
     {
      "key": "c06_1",
      "start": 359.65,
      "dur": 6.7,
      "text": "Ama savunucular her gece yıkılan yerleri toprak, tahta ve taşla yeniden kapattı."
     },
     {
      "key": "c06_x0",
      "start": 368.55,
      "dur": 6.65,
      "text": "Yorgun savunucular uyumadan çalışıyordu. Her sabah Osmanlı topçuları yeniden başlıyordu."
     },
     {
      "key": "c06_2",
      "start": 377.4,
      "dur": 8.25,
      "text": "Yirmi Nisan'da denizde büyük bir çarpışma oldu. Dört Hristiyan gemisi Osmanlı donanmasını yararak Haliç'e ulaştı."
     },
     {
      "key": "c06_3",
      "start": 387.85,
      "dur": 4.8,
      "text": "Sultan öfkeliydi. Yeni ve çok cesur bir plana ihtiyacı vardı."
     },
     {
      "key": "c06_x1",
      "start": 394.85,
      "dur": 6.2,
      "text": "Bu küçük zafer şehirde büyük bir umut yarattı. Ama bu umut uzun sürmeyecekti."
     }
    ],
    "en": [
     {
      "key": "c06_0",
      "start": 351.4,
      "dur": 6.05,
      "text": "For weeks the bombardment never stopped. Great breaches opened in the walls."
     },
     {
      "key": "c06_1",
      "start": 359.65,
      "dur": 7.25,
      "text": "But every night the defenders sealed the ruined sections again with earth, timber and stone."
     },
     {
      "key": "c06_x0",
      "start": 369.1,
      "dur": 6.5,
      "text": "The exhausted defenders worked without sleep. And every morning, the Ottoman guns began again."
     },
     {
      "key": "c06_2",
      "start": 377.8,
      "dur": 9.6,
      "text": "On April twentieth a great battle broke out at sea. Four Christian ships fought through the Ottoman fleet and reached the Golden Horn."
     },
     {
      "key": "c06_3",
      "start": 389.6,
      "dur": 5.1,
      "text": "The Sultan was furious. He needed a new and very bold plan."
     },
     {
      "key": "c06_x1",
      "start": 396.9,
      "dur": 6.85,
      "text": "This small victory brought great hope to the city. But that hope would not last long."
     }
    ]
   },
